# --- Service endpoints ---
QDRANT_URL=http://localhost:6333
MLFLOW_TRACKING_URI=http://localhost:5001

# --- RAGAS generation eval (optional) ---
ANTHROPIC_API_KEY=                 # required only for `make eval-*` RAGAS runs
RAGAS_SAMPLE_SIZE=100              # queries to evaluate for generation metrics

# --- Runtime ---
RAGBENCH_DEVICE=cpu               # or cuda
HF_SPACE=false                    # true -> SciFact-only mode (HuggingFace Spaces)

# --- Data root (override if mounting elsewhere) ---
RAGBENCH_DATA_DIR=data
