# --- Service endpoints ---
QDRANT_URL=http://localhost:6333
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Generation: POST /api/{dataset}/ask + RAGAS eval (optional) ---
ANTHROPIC_API_KEY=                 # RAGAS judge, and /ask when generation.provider is anthropic
OPENAI_API_KEY=                    # /ask when generation.provider is openai (gpt-5-nano)
RAGAS_SAMPLE_SIZE=100              # queries to evaluate for generation metrics
# RAGBENCH_GENERATION_PROVIDER=fake  # offline stub LLM (no key, no cost); tests use this

# --- Runtime ---
RAGBENCH_DEVICE=cpu               # or cuda
HF_SPACE=false                    # true -> SciFact-only mode (HuggingFace Spaces)

# --- Data root (override if mounting elsewhere) ---
RAGBENCH_DATA_DIR=data
